# ============================================================
# VibeZone app env — copy to `.env.local` (dev) / set in Vercel UI (prod)
# NEVER commit real values, NEVER paste secrets in chat. (PRD D5/Q2)
# ============================================================

# --- Database: Neon Postgres (free tier) ---
# Neon dashboard → Connect → copy BOTH connection strings:
#  · DATABASE_URL = pooled  (host contains `-pooler`) → used by the app on Vercel
#  · DIRECT_URL   = direct  (host without `-pooler`) → used by prisma db push / migrations
# Keep `sslmode=require`. For serverless, add `&pgbouncer=true` to the pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/vibezone?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/vibezone?sslmode=require"

# --- Session signing (generate: openssl rand -hex 32) ---
SESSION_SECRET=""

# --- Auth policy (D11): comma-separated, case-insensitive suffix match ---
CAMPUS_EMAIL_DOMAINS="pwioi.com"
# First login by these emails → role=admin (D10, super admin = you)
SUPER_ADMIN_EMAILS=""

# --- Mailer (Gmail SMTP, D8) ---
# Local dev: leave MAILER_URL empty → OTP is printed in the terminal instead of emailed.
# On Vercel: MAILER_URL="https://<app-domain>/api/mailer/send" (serverless mailer route).
MAILER_URL=""
MAILER_SECRET=""
# Gmail account + App Password (Google Account → Security → 2-Step Verification → App passwords).
# Only needed where the mailer actually runs (the serverless route / the VM service).
SMTP_USER=""
SMTP_APP_PASSWORD=""

# --- Realtime gateway on the VM (Socket.IO). Empty → chat falls back to polling. ---
# Public WSS base, e.g. https://<VM_IP>.sslip.io
NEXT_PUBLIC_REALTIME_URL=""
# Shared secret for the app → gateway /publish call (server-side only)
REALTIME_SECRET=""

# --- Web Push (VAPID). Generate once: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vibezoneioi25@gmail.com"

# --- Anonymous feedback ip_hash salt (falls back to SESSION_SECRET) ---
FEEDBACK_SALT=""

# --- Chat profanity/keyword filter (comma-separated; defaults are built in) ---
CHAT_FILTER_WORDS=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# GA4 (optional — analytics stays off locally until you create the free GA4 property)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
