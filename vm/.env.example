# ============================================================
# VibeZone VM env — copy to `vm/.env` ON THE VM (gitignored).
# Secrets live here + in Vercel UI only — never in git, never in chat.
# ============================================================

# --- Postgres (D7) ---
POSTGRES_USER=vibezone
POSTGRES_PASSWORD=            # long random: openssl rand -hex 24
POSTGRES_DB=vibezone
POSTGRES_PORT=15432           # non-standard public port
PG_MAX_CONN=40

# --- Gmail SMTP (D8) ---
SMTP_USER=vibezoneioi25@gmail.com
SMTP_APP_PASSWORD=            # 16-char Gmail App Password (Q2 — ROTATE before launch)
MAILER_SECRET=                # long random; same value goes to Vercel MAILER_SECRET

# --- Caddy ---
CADDY_DOMAIN=                 # <VM_IP>.sslip.io — set after VM creation
