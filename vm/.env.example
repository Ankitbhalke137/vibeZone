# VibeZone VM stack (D12: database is Neon — no Postgres container)
# Run on the VM:  cp .env.example .env  → fill secrets → docker compose up -d --build
# Services: Mailer (Gmail SMTP) · Realtime Socket.IO gateway · Scheduler · Caddy (HTTPS/WSS)

# --- Neon Postgres (same values as the Vercel app) ---
# Use the POOLED URL for long-running containers; add &pgbouncer=true if not already present.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/vibezone?sslmode=require&pgbouncer=true

# --- Session signing — MUST equal the Vercel app's SESSION_SECRET ---
SESSION_SECRET=

# --- Realtime gateway ---
REALTIME_SECRET=            # long random; same value goes to Vercel REALTIME_SECRET
APP_ORIGIN=                 # e.g. https://vibezone.vercel.app (comma-separated allowed)

# --- Gmail SMTP (D8) ---
SMTP_USER=vibezoneioi25@gmail.com
SMTP_APP_PASSWORD=          # 16-char Gmail App Password (Q2 — ROTATE before launch)
MAILER_SECRET=              # long random; same value goes to Vercel MAILER_SECRET

# --- Web Push (same VAPID pair as Vercel) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vibezoneioi25@gmail.com

# --- Scheduler ---
APP_URL=https://vibezone.vercel.app

# --- Caddy ---
CADDY_DOMAIN=               # <VM_IP>.sslip.io — set after VM creation
